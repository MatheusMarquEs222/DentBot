      },
      "id": "05ccc8fa-124b-4e8c-b57b-abb21f4f7525",
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-208, -224],
      "webhookId": "whatsapp-clinica"
    },
    {
      "parameters": {
        "jsCode": "// Extrai os dados essenciais do payload da Evolution API (evento MESSAGES_UPSERT)\nconst body = $input.first().json.body || $input.first().json;\nconst data = body.data || {};\nconst key = data.key || {};\n\n// Ignora mensagens enviadas pelo proprio numero (fromMe) e status sem conteudo\nconst fromMe = key.fromMe === true;\nconst remoteJid = key.remoteJid || '';\n\n// Telefone limpo (remove @s.whatsapp.net / @lid)\nconst telefone = remoteJid.split('@')[0];\n\n// Texto da mensagem pode vir em 'conversation' ou 'extendedTextMessage.text'\nconst msg = data.message || {};\nconst texto = (msg.conversation || (msg.extendedTextMessage && msg.extendedTextMessage.text) || '').trim();\n\nconst pushName = data.pushName || '';\nconst instancia = body.instance || 'clinica';\n\nreturn [{\n  json: { telefone, remoteJid, texto, fromMe, pushName, instancia, recebido: !fromMe && texto.length > 0 }\n}];"
      },
      "id": "b8e4a3e3-6e24-4597-8cb9-d60566a025b8",
      "name": "Extrair Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [16, -224]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-valida",
              "leftValue": "={{ $json.recebido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0ac7f91f-5836-4ec4-a08c-93c7ee6ba0a8",
      "name": "E mensagem valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, -224]
    },
    {
      "parameters": {
        "jsCode": "// Monta a resposta do menu de boas-vindas\nconst nome = $json.pushName ? ` ${$json.pushName}` : '';\n\nconst texto = `Ola!${nome} Seja bem-vindo(a) ao nosso consultorio odontologico! Sou o assistente virtual e estou aqui para agilizar seu atendimento. Como posso te ajudar hoje?\\n\\nPor favor, digite o numero da opcao desejada:\\n\\n1 - Agendar uma nova consulta\\n2 - Reagendar ou cancelar consulta\\n3 - Duvidas sobre tratamentos ou convenios\\n4 - Falar com um(a) recepcionista`;\n\nreturn [{ json: { telefone: $json.telefone, instancia: $json.instancia, resposta: texto } }];"
      },
      "id": "c2c073c4-8380-4f4b-b120-a88672372468",
      "name": "Montar Menu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, -304]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://evolution-api.railway.internal:8080/message/sendText/{{ $json.instancia }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "COLE-AQUI-SUA-AUTHENTICATION-API-KEY-DO-RAILWAY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.telefone }}\",\n  \"text\": {{ JSON.stringify($json.resposta) }}\n}",
        "options": {}
      },
      "id": "3025e8a9-343d-4c68-9f82-ad87d4c24cd2",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
