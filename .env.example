# =====================================================================
# Variáveis de ambiente — copie para .env e ajuste os valores
#   cp .env.example .env
# =====================================================================

# ---- Postgres (compartilhado entre Evolution API e n8n) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha-forte

# ---- Evolution API ----
# Chave global de autenticação da API (use um valor longo e aleatório).
# Gere com:  openssl rand -hex 32
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
# URL pública da Evolution API (em local: http://localhost:8080)
EVOLUTION_SERVER_URL=http://localhost:8080

# ---- n8n ----
# Chave que criptografa as credenciais salvas no n8n. NÃO PERCA esse valor.
# Gere com:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria
# Host/URL do n8n (em local: localhost / http://localhost:5678/)
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
